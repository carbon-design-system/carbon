{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"],
    "noImplicitAny": false,
    "strict": false,
    "paths": {
      "@carbon/angular": ["./.entries/index.ts"],
      "@carbon/angular/*": ["./.entries/*/index.ts"],
      "#carbon-ng/*": ["./.entries/vendor/*"]
    }
  },
  "include": ["src/**/*.ts", ".storybook/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.e2e.ts"]
}
