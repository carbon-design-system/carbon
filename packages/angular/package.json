{
  "name": "@carbon/angular",
  "description": "Angular components for the Carbon Design System",
  "version": "0.0.0-prerelease.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carbon-design-system/carbon.git",
    "directory": "packages/angular"
  },
  "bugs": "https://github.com/carbon-design-system/carbon/issues",
  "keywords": [
    "ibm",
    "carbon",
    "carbon-design-system",
    "components",
    "angular"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "clean": "rimraf esm2022 fesm2022",
    "e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "storybook": "npx ng run carbon-angular:storybook",
    "storybook:build": "npx ng run carbon-angular:build-storybook",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17",
    "@angular/forms": ">=17",
    "@carbon/styles": ">=2",
    "@carbon/web-components": "workspace:^"
  },
  "dependencies": {
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.1900.0",
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular-devkit/core": "^19.0.0",
    "@angular/animations": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@carbon/styles": "workspace:^",
    "@carbon/web-components": "workspace:^",
    "@playwright/test": "^1.46.1",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-links": "10.3.5",
    "@storybook/angular": "10.3.5",
    "@types/jest": "^30.0.0",
    "http-server": "^14.1.1",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^16.0.0",
    "ng-packagr": "^19.0.0",
    "rimraf": "^6.0.1",
    "rxjs": "^7.4.0",
    "storybook": "10.3.5",
    "storybook-addon-accessibility-checker": "^9.2.0-rc.4",
    "typescript": "~5.8.3",
    "zone.js": "~0.15.0"
  }
}
