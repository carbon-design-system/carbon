# Dependency directory
node_modules

# Generated by npm@5, but project currently uses Yarn
package-lock.json

# Lockfiles in example apps are intentionally not committed. Examples resolve
# dependencies fresh at build time so previews pick up patched transitive
# versions instead of pinning stale vulnerable ones. `tasks/examples.js` creates
# the empty sentinel lockfile Yarn requires to treat each example as its own
# project, then installs with `--no-immutable`.
**/examples/**/yarn.lock

# Directories generated by Next.js
.next

# Accessibility Verification Testing
.avt/

# Playwright
.playwright
blob-report
test-results

# Local token
.env

# nx local build cache
.nx/cache
.nx/workspace-data

# Yarn
.yarn/*
!.yarn/patches/
!.yarn/releases/
**/.yarn/cache/
**/.yarn/build-state.yml
**/.yarn/install-state.gz

# Generated DTCG color palette (built from @carbon/colors at build time)
packages/themes/src/dtcg/color-palette.json
